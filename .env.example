# Optional override for the contact form Formspree id
# VITE_FORMSPREE_ID=your_form_id

# Canonical origin. Defaults to the verified production host:
# https://react-portfolio-main-erik-williams-projects.vercel.app
# Set this only when a real custom domain serves the site. Do not point it at a preview URL.
# VITE_SITE_URL=

# index or noindex. When unset:
# - vite dev, and Vercel preview/development builds, are noindex,follow
# - production builds stay index,follow (the existing public HTML policy)
# robots.txt still allows crawling so a noindex tag can be discovered.
# VITE_INDEXING=

# AI crawlers are allowed unless set to disallow. Search and training are separate.
# disallow writes robots.txt rules for those bots only. It is not a Google Search
# noindex, and blocking a bot means it cannot see a noindex tag.
# VITE_AI_SEARCH_CRAWLERS=allow
# VITE_AI_TRAINING_CRAWLERS=allow

# Optional Google Search Console verification token. Omitted when empty.
# VITE_GOOGLE_SITE_VERIFICATION=
